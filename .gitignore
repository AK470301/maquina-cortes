# Segredos: só o .env.example (sem valores) vai para o git
.env
.env.*
!.env.example

# Dependências e caches
node_modules/
.venv/
.cache/
__pycache__/

# Mídia pesada e dados de cada live (VODs, transcrições, renders)
cortes/
compilados/
work/
render/
final/
*.mp4
*.mkv
*.webm
*.mov
para-postar/*
!para-postar/.gitkeep
postados/*
!postados/.gitkeep
assets/broll-gta6/*.mp4

# Estado de execução
fila/
notificados.json
postado.json
postagem.json
!config/postagem.json
banco-compilado/segmentos.json

# Gerado pelo setup.mjs do motor ao instalar o whisper (a instalação aponta para dentro do repositório)
motor-cortes/motor/scripts/_install-whisper.mjs

# Locais do Claude Code
.claude/settings.local.json

# Backups locais (podem conter o .env)
*.zip
backup-*/

# Modo Morte Súbita: estado de execução (o config/morte-subita.ativo vai para o git)
fila-entrada/
logs/
