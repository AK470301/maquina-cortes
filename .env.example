# Copie para .env e preencha. O .env nunca vai para o git.

# Publicação pela Zernio (publicador "zernio" em pipeline.config.json)
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=
ZERNIO_YOUTUBE_ACCOUNT_ID=

# Publicação por webhook/REST (publicador "webhook")
POST_API_URL=
POST_API_KEY=

# E-mail de aviso de vídeos para aprovação (Resend)
RESEND_API_KEY=
EMAIL_DESTINO=
EMAIL_REMETENTE=onboarding@resend.dev

# ffmpeg com VAAPI/NVENC para os encodes do compilado (ex.: /usr/bin/ffmpeg)
FFMPEG_HW=
